---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact Us"
  description="Get in touch with Promote Waipu — Waipu's community and business promotion group."
>

  <div class="page-hero page-hero--short">
    <h1>Contact Us</h1>
    <p>We'd love to hear from you</p>
  </div>

  <div class="container section two-col">

    <!-- CONTACT DETAILS -->
    <div class="contact-info">
      <h2>Get in Touch</h2>
      <p>
        Promote Waipu is run by a volunteer committee. We'll do our best to get back 
        to you as quickly as possible.
      </p>
      <ul class="contact-list">
        <li>
          <strong>General enquiries</strong><br />
          <a href="mailto:hello@promotewaipu.co.nz">hello@promotewaipu.co.nz</a>
        </li>
        <li>
          <strong>Secretary</strong><br />
          <a href="mailto:secretary@promotewaipu.co.nz">secretary@promotewaipu.co.nz</a>
        </li>
        <li>
          <strong>Follow us</strong><br />
          <a href="https://www.facebook.com/PromoteWaipu" target="_blank" rel="noopener">
            Facebook — @PromoteWaipu
          </a>
        </li>
      </ul>

      <h3>Business &amp; Membership</h3>
      <p>
        Want to add your business to the directory or become a member?<br />
        <a href="/directory/add">Add a business listing →</a><br />
        <a href="/join">Join Promote Waipu →</a>
      </p>
    </div>

    <!-- ENQUIRY FORM (Formspree) -->
    <div class="contact-form-wrap">
      <h2>Send us a Message</h2>
      <!--
        Replace YOUR_FORM_ID with your Formspree form ID.
        Sign up free at https://formspree.io — create a form, get the ID.
        Submissions are emailed to hello@promotewaipu.co.nz
      -->
      <form
        action="https://formspree.io/f/YOUR_FORM_ID"
        method="POST"
        class="form"
        id="contact-form"
      >
        <div class="form-group">
          <label for="name">Your Name <span aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>

        <div class="form-group">
          <label for="email">Email Address <span aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>

        <div class="form-group">
          <label for="phone">Phone (optional)</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" />
        </div>

        <div class="form-group">
          <label for="subject">Subject <span aria-hidden="true">*</span></label>
          <select id="subject" name="subject" required>
            <option value="">— Please select —</option>
            <option value="General enquiry">General enquiry</option>
            <option value="Event information">Event information</option>
            <option value="Membership">Membership</option>
            <option value="Business listing">Business listing</option>
            <option value="Volunteering">Volunteering</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="form-group">
          <label for="message">Message <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <!-- Honeypot spam protection -->
        <input type="text" name="_gotcha" style="display:none" />

        <!-- Redirect after submission -->
        <input type="hidden" name="_next" value="https://www.promotewaipu.co.nz/thank-you" />

        <button type="submit" class="btn btn-primary">Send Message</button>

        <p class="form-note">
          * Required fields. We respect your privacy and will never share your details.
        </p>
      </form>
    </div>

  </div>
</Base>
