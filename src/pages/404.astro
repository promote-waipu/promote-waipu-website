---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found"
  description="Sorry, the page you're looking for doesn't exist."
>
  <div class="container py-5 text-center">
    <div class="py-5">
      <p class="display-1 fw-bold text-primary mb-0">404</p>
      <h1 class="fw-bold mb-3">Page Not Found</h1>
      <p class="lead text-muted mb-4" style="max-width:480px; margin:0 auto">
        Sorry, we couldn't find that page. It may have moved, been removed,
        or the link might be a wee bit off.
      </p>
      <div class="d-flex flex-wrap justify-content-center gap-2">
        <a href="/" class="btn btn-primary btn-lg">
          <i class="bi bi-house-fill me-1"></i> Back to Home
        </a>
        <a href="/directory" class="btn btn-outline-primary btn-lg">
          <i class="bi bi-grid me-1"></i> Business Directory
        </a>
        <a href="/events" class="btn btn-outline-secondary btn-lg">
          <i class="bi bi-calendar3 me-1"></i> Events
        </a>
      </div>
      <p class="mt-5 text-muted small">
        Looking for something specific?
        <a href="/contact">Contact us</a> and we'll help you find it.
      </p>
    </div>
  </div>
</Base>
