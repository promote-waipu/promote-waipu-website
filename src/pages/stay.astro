---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allListings = await getCollection('directory');
const accommodation = allListings
  .filter(l => l.data.published && l.data.category === 'Accommodation')
  .sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0));
---

<Base
  title="Places to Stay in Waipu"
  description="Find accommodation in Waipu, Northland NZ — holiday parks, beach resorts, B&Bs and self-contained holiday units near Waipu Cove and Langs Beach."
>

  <div class="page-header">
    <div class="container">
      <h1 class="fw-bold">Places to Stay</h1>
      <p>Accommodation in Waipu, Northland, New Zealand</p>
    </div>
  </div>

  <!-- INTRO -->
  <section class="py-5 bg-sand">
    <div class="container">
      <div class="row g-4 align-items-center">
        <div class="col-lg-7">
          <h2 class="section-title h3">Your Waipu Escape Awaits</h2>
          <p class="lead">
            Whether you're looking for a classic Kiwi holiday park, a boutique B&amp;B
            with sea views, or a self-contained unit steps from the beach — Waipu has
            accommodation to suit every taste and budget.
          </p>
          <p>
            Waipu Cove and Langs Beach are two of Northland's most beautiful stretches
            of sand, with clear water ideal for swimming, surfing and kayaking. Stay here
            as your base to explore the Waipu Caves glow worms, the historic museum and
            the village's great cafes and restaurants.
          </p>
        </div>
        <div class="col-lg-5">
          <div class="row g-3">
            <div class="col-6">
              <div class="stay-feature">
                <i class="bi bi-water text-primary fs-3 mb-2 d-block"></i>
                <strong class="d-block">Beach Access</strong>
                <p class="small mb-0">Steps from Waipu Cove &amp; Langs Beach</p>
              </div>
            </div>
            <div class="col-6">
              <div class="stay-feature">
                <i class="bi bi-house-heart text-primary fs-3 mb-2 d-block"></i>
                <strong class="d-block">Every Budget</strong>
                <p class="small mb-0">Campsites, cabins, B&amp;Bs &amp; resorts</p>
              </div>
            </div>
            <div class="col-6">
              <div class="stay-feature">
                <i class="bi bi-geo-alt text-primary fs-3 mb-2 d-block"></i>
                <strong class="d-block">Great Location</strong>
                <p class="small mb-0">90 min north of Auckland</p>
              </div>
            </div>
            <div class="col-6">
              <div class="stay-feature">
                <i class="bi bi-signpost-split text-primary fs-3 mb-2 d-block"></i>
                <strong class="d-block">Explore Nearby</strong>
                <p class="small mb-0">Caves, walks, markets &amp; more</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ACCOMMODATION LISTINGS -->
  <section class="py-5">
    <div class="container">
      <h2 class="section-title h3">Accommodation in Waipu</h2>

      {accommodation.length > 0 ? (
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
          {accommodation.map(listing => (
            <div class="col">
              <div class={`card h-100 directory-card rounded-3 shadow-sm border-0 ${listing.data.featured ? 'featured-card' : ''}`} style="position:relative">
                {listing.data.featured && (
                  <span class="featured-badge">Featured</span>
                )}
                {listing.data.image && (
                  <img src={listing.data.image}
                       alt={listing.data.name}
                       class="card-img-top event-card-img" />
                )}
                <div class="card-body">
                  {listing.data.logo && (
                    <img src={listing.data.logo}
                         alt={`${listing.data.name} logo`}
                         class="mb-2" style="max-height:48px; object-fit:contain" />
                  )}
                  <h5 class="card-title">{listing.data.name}</h5>
                  {listing.data.address && (
                    <p class="text-muted small mb-1">
                      <i class="bi bi-geo-alt me-1"></i>{listing.data.address}
                    </p>
                  )}
                  {listing.data.phone && (
                    <p class="text-muted small mb-1">
                      <i class="bi bi-telephone me-1"></i>
                      <a href={`tel:${listing.data.phone}`} class="text-reset">{listing.data.phone}</a>
                    </p>
                  )}
                  {listing.data.description && (
                    <p class="card-text small mt-2">{listing.data.description}</p>
                  )}
                </div>
                {(listing.data.website || listing.data.facebook) && (
                  <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 px-3 d-flex gap-2">
                    {listing.data.website && (
                      <a href={listing.data.website}
                         target="_blank" rel="noopener"
                         class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-globe me-1"></i> Website
                      </a>
                    )}
                    {listing.data.facebook && (
                      <a href={listing.data.facebook}
                         target="_blank" rel="noopener"
                         class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-facebook me-1"></i> Facebook
                      </a>
                    )}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-5">
          <i class="bi bi-house-heart text-primary" style="font-size:3rem"></i>
          <p class="mt-3 text-muted">Accommodation listings coming soon.</p>
          <a href="/directory/add" class="btn btn-primary mt-2">
            Add Your Accommodation
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band py-4">
    <div class="container text-center">
      <h3 class="fw-bold mb-2">Own Accommodation in Waipu?</h3>
      <p class="mb-3">Get a free listing in our directory and be seen by thousands of visitors.</p>
      <a href="/directory/add" class="btn btn-light fw-semibold me-2">Add Your Listing</a>
      <a href="/join" class="btn btn-outline-light">Become a Member</a>
    </div>
  </section>

</Base>
