---
import Base from '../layouts/Base.astro';
import about from '../data/about.json';
---

<Base title={about.seo_title} description={about.seo_description}>

  <div class="page-header">
    <div class="container">
      <h1 class="fw-bold">{about.page_heading}</h1>
      <p>{about.page_subheading}</p>
    </div>
  </div>

  <!-- ABOUT SECTION -->
  <section class="py-5">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-7">
          <h2 class="section-title h3">{about.who_heading}</h2>
          <p class="lead">{about.who_lead}</p>
          {about.who_body.split('\n\n').map((p: string) => <p>{p}</p>)}
          <p>
            For more information, email{' '}
            <a href={`mailto:${about.contact_email}`}>{about.contact_email}</a>
          </p>
        </div>
        <div class="col-lg-5">
          <img src="/images/waipu-village.jpg"
               alt="Waipu village"
               class="img-fluid rounded-3 shadow-sm mb-4" />
          <div class="card border-0 bg-sand rounded-3 p-4">
            <h5 class="fw-semibold mb-1">
              <i class="bi bi-envelope-fill text-primary me-2"></i>Get in Touch
            </h5>
            <p class="small mb-2">
              <a href="mailto:hello@promotewaipu.co.nz">hello@promotewaipu.co.nz</a>
            </p>
            <p class="small mb-0">
              <a href={`mailto:${about.contact_email}`}>{about.contact_email}</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR COMMUNITY -->
  <section class="py-5 bg-sand">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-5">
          <img src="/images/waipu-cove.jpg"
               alt="Waipu Cove beach"
               class="img-fluid rounded-3 shadow-sm" />
        </div>
        <div class="col-lg-7">
          <h2 class="section-title h3">{about.community_heading}</h2>
          <p class="lead">{about.community_lead}</p>
          {about.community_body.split('\n\n').map((p: string) => <p>{p}</p>)}
          <a href="/explore" class="btn btn-primary me-2">
            <i class="bi bi-compass me-1"></i> Explore the Area
          </a>
          <a href="/events" class="btn btn-outline-primary">
            <i class="bi bi-calendar3 me-1"></i> See Events
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- JOIN CTA -->
  <section class="cta-band py-5">
    <div class="container text-center">
      <h2 class="fw-bold mb-3">{about.cta_heading}</h2>
      <p class="lead mb-4" style="max-width:560px; margin:0 auto 1.5rem">
        {about.cta_body}
      </p>
      <a href="/join" class="btn btn-light btn-lg fw-semibold me-2 mb-2">
        <i class="bi bi-people-fill me-1"></i> Join Us Today
      </a>
      <a href="/contact" class="btn btn-outline-light btn-lg mb-2">
        <i class="bi bi-chat-fill me-1"></i> Get in Touch
      </a>
    </div>
  </section>

</Base>
