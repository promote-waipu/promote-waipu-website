---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allListings = await getCollection('directory');
const listings = allListings
  .filter(l => l.data.published)
  .sort((a, b) => {
    if (b.data.featured !== a.data.featured) return b.data.featured ? 1 : -1;
    return a.data.name.localeCompare(b.data.name);
  });

const categories = [...new Set(
  listings.map(l => l.data.category).filter(Boolean)
)].sort() as string[];
---

<Base
  title="Business Directory"
  description="Browse the Waipu Business & Community Directory — find local businesses, services and community groups in Waipu, Northland."
>

  <div class="page-header">
    <div class="container">
      <h1 class="fw-bold">Business Directory</h1>
      <p>Browse the Waipu Business &amp; Community Directory</p>
    </div>
  </div>

  <div class="container py-5">

    <!-- CATEGORY FILTER -->
    {categories.length > 0 && (
      <div class="category-filter mb-4">
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <button class="btn btn-outline-primary active" data-filter="all">All</button>
          {categories.map(cat => (
            <button class="btn btn-outline-primary" data-filter={cat}>{cat}</button>
          ))}
        </div>
      </div>
    )}

    <!-- SEARCH BAR -->
    <div class="mb-4">
      <div class="input-group" style="max-width:400px">
        <span class="input-group-text border-end-0 bg-white">
          <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text" id="dir-search" class="form-control border-start-0"
               placeholder="Search businesses…" />
      </div>
    </div>

    <!-- LISTINGS GRID -->
    {listings.length === 0 ? (
      <div class="text-center py-5">
        <i class="bi bi-building text-primary" style="font-size:3rem"></i>
        <p class="mt-3 text-muted">No listings yet. Be the first!</p>
        <a href="/directory/add" class="btn btn-primary mt-2">Add Your Business</a>
      </div>
    ) : (
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="dir-grid">
        {listings.map(listing => (
          <div class="col dir-item" data-category={listing.data.category} data-name={listing.data.name.toLowerCase()}>
            <div class={`card h-100 directory-card rounded-3 shadow-sm border-0 ${listing.data.featured ? 'featured-card' : ''}`} style="position:relative">
              {listing.data.featured && (
                <span class="featured-badge">Featured</span>
              )}
              {listing.data.image && (
                <img src={listing.data.image}
                     alt={listing.data.name}
                     class="card-img-top event-card-img" />
              )}
              <div class="card-body">
                {listing.data.logo && !listing.data.image && (
                  <img src={listing.data.logo}
                       alt={`${listing.data.name} logo`}
                       class="mb-2 d-block"
                       style="max-height:48px; object-fit:contain; max-width:120px" />
                )}
                {listing.data.category && (
                  <span class="badge badge-category rounded-pill mb-2">
                    {listing.data.category}
                  </span>
                )}
                <h5 class="card-title mb-1">{listing.data.name}</h5>
                {listing.data.address && (
                  <p class="text-muted small mb-1">
                    <i class="bi bi-geo-alt me-1"></i>{listing.data.address}
                  </p>
                )}
                {listing.data.phone && (
                  <p class="text-muted small mb-1">
                    <i class="bi bi-telephone me-1"></i>
                    <a href={`tel:${listing.data.phone}`} class="text-reset">{listing.data.phone}</a>
                  </p>
                )}
                {listing.data.email && (
                  <p class="text-muted small mb-1">
                    <i class="bi bi-envelope me-1"></i>
                    <a href={`mailto:${listing.data.email}`} class="text-reset">{listing.data.email}</a>
                  </p>
                )}
                {listing.data.description && (
                  <p class="card-text small mt-2">{listing.data.description}</p>
                )}
              </div>
              {(listing.data.website || listing.data.facebook || listing.data.instagram) && (
                <div class="card-footer bg-transparent border-top-0 pb-3 px-3 d-flex flex-wrap gap-2">
                  {listing.data.website && (
                    <a href={listing.data.website}
                       target="_blank" rel="noopener"
                       class="btn btn-outline-primary btn-sm">
                      <i class="bi bi-globe me-1"></i>Website
                    </a>
                  )}
                  {listing.data.facebook && (
                    <a href={listing.data.facebook}
                       target="_blank" rel="noopener"
                       class="btn btn-outline-secondary btn-sm">
                      <i class="bi bi-facebook me-1"></i>Facebook
                    </a>
                  )}
                  {listing.data.instagram && (
                    <a href={listing.data.instagram}
                       target="_blank" rel="noopener"
                       class="btn btn-outline-secondary btn-sm">
                      <i class="bi bi-instagram me-1"></i>Instagram
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    )}

    <p id="no-results" class="text-center text-muted mt-4" style="display:none">
      No businesses match your search. <a href="#" id="clear-filter">Clear filter</a>
    </p>

    <!-- ADD LISTING CTA -->
    <div class="card border-0 bg-sand rounded-3 p-4 mt-5 text-center">
      <h5 class="fw-semibold mb-2">Is your Waipu business listed?</h5>
      <p class="text-muted small mb-3">Basic listings are free for all Waipu-based businesses and community groups.</p>
      <a href="/directory/add" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Add Your Business
      </a>
    </div>

  </div>
</Base>

<script>
// Category filter + search
const grid = document.getElementById('dir-grid');
const noResults = document.getElementById('no-results');
const searchInput = document.getElementById('dir-search') as HTMLInputElement;
const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
const clearFilter = document.getElementById('clear-filter');

let activeFilter = 'all';

function applyFilters() {
  const q = searchInput?.value.toLowerCase().trim() || '';
  let visible = 0;
  document.querySelectorAll<HTMLElement>('.dir-item').forEach(item => {
    const matchesCat = activeFilter === 'all' || item.dataset.category === activeFilter;
    const matchesSearch = !q || (item.dataset.name || '').includes(q);
    const show = matchesCat && matchesSearch;
    item.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
}

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeFilter = btn.dataset.filter || 'all';
    applyFilters();
  });
});

searchInput?.addEventListener('input', applyFilters);

clearFilter?.addEventListener('click', e => {
  e.preventDefault();
  searchInput.value = '';
  activeFilter = 'all';
  filterBtns.forEach(b => b.classList.remove('active'));
  filterBtns[0]?.classList.add('active');
  applyFilters();
});

// Pre-filter from URL query param ?cat=...
const urlCat = new URLSearchParams(window.location.search).get('cat');
if (urlCat) {
  const matchBtn = [...filterBtns].find(b => b.dataset.filter === urlCat);
  if (matchBtn) matchBtn.click();
}
</script>
