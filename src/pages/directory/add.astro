---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Add Your Business Listing"
  description="Add your Waipu business or community group to the Promote Waipu directory. Basic listings are free."
>

  <div class="page-header">
    <div class="container">
      <h1 class="fw-bold">Add Your Business</h1>
      <p>Get listed in the Waipu Business &amp; Community Directory</p>
    </div>
  </div>

  <div class="container py-5">

    <!-- PRICING -->
    <div class="row g-4 mb-5">
      <div class="col-md-6">
        <div class="pricing-card h-100">
          <h4 class="fw-bold mb-1">Free Listing</h4>
          <p class="fs-3 fw-bold text-primary mb-3">$0</p>
          <ul class="list-group list-group-flush mb-3">
            <li class="list-group-item border-0 ps-0 small"><i class="bi bi-check text-primary me-2"></i>Business name</li>
            <li class="list-group-item border-0 ps-0 small"><i class="bi bi-check text-primary me-2"></i>Category</li>
            <li class="list-group-item border-0 ps-0 small"><i class="bi bi-check text-primary me-2"></i>Phone number</li>
            <li class="list-group-item border-0 ps-0 small"><i class="bi bi-check text-primary me-2"></i>Email address</li>
            <li class="list-group-item border-0 ps-0 small"><i class="bi bi-check text-primary me-2"></i>Basic description</li>
          </ul>
          <p class="small text-muted mb-0">
            Available to all Waipu-based businesses and non-profit groups.
          </p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="pricing-card pricing-member h-100">
          <div class="d-flex align-items-start justify-content-between">
            <div>
              <h4 class="fw-bold mb-1">Member Listing</h4>
              <p class="mb-3">
                Included with <a href="/join" class="fw-semibold">$60 membership</a>
              </p>
            </div>
            <span class="badge bg-primary rounded-pill">Best value</span>
          </div>
          <ul class="list-group list-group-flush mb-3">
            <li class="list-group-item border-0 ps-0 bg-transparent small"><i class="bi bi-check-circle-fill text-primary me-2"></i>Everything in Free, plus:</li>
            <li class="list-group-item border-0 ps-0 bg-transparent small"><i class="bi bi-check-circle-fill text-primary me-2"></i>Logo displayed</li>
            <li class="list-group-item border-0 ps-0 bg-transparent small"><i class="bi bi-check-circle-fill text-primary me-2"></i>Website &amp; Facebook links</li>
            <li class="list-group-item border-0 ps-0 bg-transparent small"><i class="bi bi-check-circle-fill text-primary me-2"></i>Up to 3 photos</li>
            <li class="list-group-item border-0 ps-0 bg-transparent small"><i class="bi bi-check-circle-fill text-primary me-2"></i>Extended description</li>
            <li class="list-group-item border-0 ps-0 bg-transparent small"><i class="bi bi-check-circle-fill text-primary me-2"></i>Featured in category</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- LISTING FORM -->
    <div class="card border-0 shadow-sm rounded-3 p-4 p-md-5">
      <!--
        Replace YOUR_LISTING_FORM_ID with your Formspree form ID.
        Submissions go to secretary@promotewaipu.co.nz
      -->
      <form
        action="https://formspree.io/f/YOUR_LISTING_FORM_ID"
        method="POST"
        enctype="multipart/form-data"
      >
        <h3 class="section-title h4">Your Details</h3>
        <div class="row g-3 mb-4">
          <div class="col-sm-6">
            <label for="contact_name" class="form-label">
              Contact Name <span class="required-star">*</span>
            </label>
            <input type="text" id="contact_name" name="contact_name"
                   class="form-control" required autocomplete="name" />
          </div>
          <div class="col-sm-6">
            <label for="contact_email" class="form-label">
              Contact Email <span class="required-star">*</span>
            </label>
            <input type="email" id="contact_email" name="contact_email"
                   class="form-control" required autocomplete="email" />
          </div>
          <div class="col-sm-6">
            <label for="contact_phone" class="form-label">Phone</label>
            <input type="tel" id="contact_phone" name="contact_phone"
                   class="form-control" autocomplete="tel" />
          </div>
          <div class="col-sm-6">
            <label for="listing_type" class="form-label">
              Listing Type <span class="required-star">*</span>
            </label>
            <select id="listing_type" name="listing_type" class="form-select" required>
              <option value="">— Select —</option>
              <option>Free listing</option>
              <option>Member listing ($60 membership)</option>
              <option>Non-profit / community group (free)</option>
            </select>
          </div>
        </div>

        <h3 class="section-title h4">Business Information</h3>
        <div class="row g-3 mb-4">
          <div class="col-12">
            <label for="business_name" class="form-label">
              Business / Organisation Name <span class="required-star">*</span>
            </label>
            <input type="text" id="business_name" name="business_name"
                   class="form-control" required />
          </div>
          <div class="col-sm-6">
            <label for="category" class="form-label">
              Category <span class="required-star">*</span>
            </label>
            <select id="category" name="category" class="form-select" required>
              <option value="">— Select category —</option>
              <option>Accommodation</option>
              <option>Advertising &amp; Promotion</option>
              <option>Antiques &amp; Collectibles</option>
              <option>Automotive</option>
              <option>Bakery &amp; Cafe</option>
              <option>Bars &amp; Pubs</option>
              <option>Beauty</option>
              <option>Building &amp; Construction</option>
              <option>Cattery</option>
              <option>Clothing</option>
              <option>Coaching</option>
              <option>Community Groups</option>
              <option>Education</option>
              <option>Engineering</option>
              <option>Excavator Hire</option>
              <option>Florist</option>
              <option>Gift Shop</option>
              <option>Golf Club</option>
              <option>Grocers &amp; Supermarkets</option>
              <option>Hairdresser</option>
              <option>Hardware</option>
              <option>Health &amp; Wellbeing</option>
              <option>Jewellers</option>
              <option>Landscapers &amp; Nursery</option>
              <option>Lawyers</option>
              <option>Liquor Store</option>
              <option>Local Food Producer</option>
              <option>Manufacturers</option>
              <option>Massage</option>
              <option>Museum</option>
              <option>Pharmacy</option>
              <option>Professional Services</option>
              <option>Radio</option>
              <option>Real Estate Agents</option>
              <option>Rest Home</option>
              <option>Restaurants</option>
              <option>Second Hand Shops</option>
              <option>Sports &amp; Recreation</option>
              <option>Trades</option>
              <option>Venues</option>
              <option>Vet</option>
              <option>Yoga</option>
              <option>Other</option>
            </select>
          </div>
          <div class="col-sm-6">
            <label for="gst_number" class="form-label">GST Number (if applicable)</label>
            <input type="text" id="gst_number" name="gst_number" class="form-control" />
          </div>
          <div class="col-12">
            <label for="address" class="form-label">Street Address</label>
            <input type="text" id="address" name="address"
                   class="form-control" autocomplete="street-address" />
          </div>
          <div class="col-12">
            <label for="description" class="form-label">
              Business Description <span class="required-star">*</span>
            </label>
            <textarea id="description" name="description" class="form-control"
                      rows="5" required
                      placeholder="Tell us about your business — what you offer, your hours, what makes you special…"></textarea>
          </div>
        </div>

        <h3 class="section-title h4">Online Presence</h3>
        <div class="row g-3 mb-4">
          <div class="col-sm-6">
            <label for="website" class="form-label">Website URL</label>
            <input type="url" id="website" name="website"
                   class="form-control" placeholder="https://" />
          </div>
          <div class="col-sm-6">
            <label for="facebook" class="form-label">Facebook Page URL</label>
            <input type="url" id="facebook" name="facebook"
                   class="form-control" placeholder="https://facebook.com/…" />
          </div>
          <div class="col-sm-6">
            <label for="instagram" class="form-label">Instagram URL (optional)</label>
            <input type="url" id="instagram" name="instagram"
                   class="form-control" placeholder="https://instagram.com/…" />
          </div>
          <div class="col-sm-6">
            <label for="logo" class="form-label">Logo (PNG or JPG, max 2MB)</label>
            <input type="file" id="logo" name="logo"
                   class="form-control" accept="image/png,image/jpeg" />
            <div class="field-note">Member listings only.</div>
          </div>
          <div class="col-12">
            <label for="message" class="form-label">Anything else you'd like to tell us?</label>
            <textarea id="message" name="message" class="form-control" rows="3"></textarea>
          </div>
        </div>

        <input type="text" name="_gotcha" style="display:none" />
        <input type="hidden" name="_next"
               value="https://www.promotewaipu.co.nz/thank-you?from=listing" />
        <input type="hidden" name="_subject"
               value="New business listing submission — Promote Waipu" />

        <button type="submit" class="btn btn-primary btn-lg">
          <i class="bi bi-send me-1"></i> Submit Listing
        </button>
        <p class="form-note">
          <span class="required-star">*</span> Required fields. Listings are reviewed by the
          Promote Waipu committee before going live. We'll be in touch within a few business days.
        </p>
      </form>
    </div>

  </div>
</Base>
