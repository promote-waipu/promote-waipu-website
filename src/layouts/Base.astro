---
import '../styles/main.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description, image } = Astro.props;
const pageTitle = title
  ? `${title} | Promote Waipu`
  : 'Promote Waipu — Waipu, Northland, New Zealand';
const pageDesc = description ||
  'Promote Waipu is a non-profit community group promoting the beautiful town of Waipu, Northland, New Zealand.';
const ogImage = image || '/images/og-default.jpg';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />

  <!-- Open Graph -->
  <meta property="og:title" content={title || 'Promote Waipu'} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Promote Waipu" />

  <!-- Local SEO -->
  <meta name="geo.region" content="NZ-NTL" />
  <meta name="geo.placename" content="Waipu, Northland, New Zealand" />
  <meta name="geo.position" content="-35.9847;174.4472" />
  <meta name="ICBM" content="-35.9847, 174.4472" />

  <!-- Schema.org -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Promote Waipu",
      "alternateName": "Waipu Business and Community Inc",
      "url": "https://www.promotewaipu.co.nz",
      "logo": "https://www.promotewaipu.co.nz/images/promote-waipu-logo.png",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "hello@promotewaipu.co.nz",
        "contactType": "customer service"
      },
      "areaServed": { "@type": "Place", "name": "Waipu, Northland, New Zealand" },
      "sameAs": ["https://www.facebook.com/PromoteWaipu"]
    }
  </script>

  <!-- Bootswatch Lumen — swap this href to change the whole theme -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/lumen/bootstrap.min.css" />
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <!-- Promote Waipu brand overrides are bundled via the Astro import in frontmatter -->

  <link rel="icon" type="image/png" href="/images/favicon.png" />
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg sticky-top bg-white site-navbar">
    <div class="container">
      <a href="/" class="navbar-brand">
        <img src="/images/promote-waipu-logo.png"
             alt="Promote Waipu — Waipu, Northland, New Zealand"
             height="48" width="auto" />
      </a>

      <button class="navbar-toggler border-0" type="button"
              data-bs-toggle="collapse" data-bs-target="#navMenu"
              aria-controls="navMenu" aria-expanded="false"
              aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1 py-2 py-lg-0">
          <li class="nav-item">
            <a href="/" class="nav-link">Home</a>
          </li>
          <li class="nav-item">
            <a href="/about" class="nav-link">About</a>
          </li>
          <li class="nav-item dropdown">
            <a href="/events" class="nav-link dropdown-toggle"
               data-bs-toggle="dropdown" aria-expanded="false">Events</a>
            <ul class="dropdown-menu shadow-sm border-0">
              <li><a href="/events" class="dropdown-item">All Events</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li><a href="/events/waipu-highland-games" class="dropdown-item">Highland Games</a></li>
              <li><a href="/events/christmas-parade" class="dropdown-item">Christmas Parade</a></li>
              <li><a href="/events/waipu-street-market" class="dropdown-item">Street Markets</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a href="/directory" class="nav-link dropdown-toggle"
               data-bs-toggle="dropdown" aria-expanded="false">Directory</a>
            <ul class="dropdown-menu shadow-sm border-0">
              <li><a href="/directory" class="dropdown-item">All Businesses</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li><a href="/directory?cat=Accommodation" class="dropdown-item">Accommodation</a></li>
              <li><a href="/directory?cat=Restaurants" class="dropdown-item">Restaurants</a></li>
              <li><a href="/directory?cat=Bakery+%26+Cafe" class="dropdown-item">Cafes</a></li>
              <li><a href="/directory?cat=Trades" class="dropdown-item">Trades &amp; Services</a></li>
              <li><a href="/directory?cat=Community+Groups" class="dropdown-item">Community Groups</a></li>
              <li><a href="/directory" class="dropdown-item fw-semibold text-primary">All Categories →</a></li>
            </ul>
          </li>
          <li class="nav-item">
            <a href="/explore" class="nav-link">Explore</a>
          </li>
          <li class="nav-item">
            <a href="/stay" class="nav-link">Stay</a>
          </li>
          <li class="nav-item">
            <a href="/contact" class="nav-link">Contact</a>
          </li>
          <li class="nav-item ms-lg-2">
            <a href="/join" class="nav-link btn-join">Join Us</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- PAGE CONTENT -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="site-footer pt-5 pb-4">
    <div class="container">
      <div class="row g-4">

        <div class="col-12 col-md-4">
          <img src="/images/promote-waipu-logo-white.png"
               alt="Promote Waipu"
               height="46" class="mb-3" />
          <p class="small">A non-profit community group promoting Waipu, Northland, New Zealand.</p>
          <a href="https://www.facebook.com/PromoteWaipu"
             target="_blank" rel="noopener"
             class="text-white fs-4 me-2" aria-label="Facebook">
            <i class="bi bi-facebook"></i>
          </a>
        </div>

        <div class="col-6 col-md-2">
          <h6>Explore</h6>
          <a href="/explore" class="footer-link">Things to Do</a>
          <a href="/stay" class="footer-link">Places to Stay</a>
          <a href="/directory?cat=Restaurants" class="footer-link">Eat &amp; Drink</a>
          <a href="/events" class="footer-link">Events</a>
          <a href="/directory?cat=Accommodation" class="footer-link">Accommodation</a>
        </div>

        <div class="col-6 col-md-2">
          <h6>Community</h6>
          <a href="/about" class="footer-link">About Us</a>
          <a href="/join" class="footer-link">Join / Membership</a>
          <a href="/directory/add" class="footer-link">Add Your Business</a>
          <a href="/contact" class="footer-link">Contact Us</a>
          <a href="/directory" class="footer-link">Business Directory</a>
        </div>

        <div class="col-12 col-md-4">
          <h6>Stay in the Loop</h6>
          <p class="small">Get Waipu news and event updates in your inbox.</p>
          <!-- Replace MAILCHIMP_FORM_ACTION with your Mailchimp form action URL -->
          <form action="MAILCHIMP_FORM_ACTION" method="post" class="d-flex gap-2">
            <input type="email" name="EMAIL" placeholder="your@email.com"
                   class="form-control form-control-sm" required />
            <button type="submit" class="btn btn-primary btn-sm text-nowrap">Subscribe</button>
          </form>
        </div>

      </div>

      <hr class="footer-divider mt-4 mb-3" />

      <div class="footer-bottom d-flex flex-wrap justify-content-between gap-2">
        <p class="mb-0">
          &copy; {new Date().getFullYear()} Waipu Business &amp; Community Inc. All rights reserved.
        </p>
        <p class="mb-0">
          <a href="/privacy">Privacy Policy</a>
        </p>
      </div>
    </div>
  </footer>

  <!-- Bootstrap JS bundle (includes Popper for dropdowns) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
